# ServiceWeave 本地配置模板；复制为 .env 后填写，真实 .env 不提交。
ANTHROPIC_API_KEY=
# 可留空使用 SDK 默认服务，或填写支持 Anthropic Messages API 的服务地址。
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=your-model-name
# 建议使用字母和数字组成的随机密码，避免 Redis URL 中的保留字符。
REDIS_PASSWORD=change-this-local-password
BACKEND_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO
ALERT_WEBHOOK_URL=
